{
    "name": "plutuss/laravel-geonames-api",
    "description": "GeoNames API client for Laravel. Search places and postal codes, reverse geocode coordinates, and look up countries and time zones.",
    "keywords": [
        "laravel",
        "geonames",
        "geocoding",
        "reverse-geocoding",
        "geolocation",
        "postal-code",
        "zip-code",
        "timezone",
        "country-info",
        "place-search",
        "coordinates",
        "geography"
    ],
    "homepage": "https://github.com/plutuss/geo-laravel",
    "minimum-stability": "stable",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "plutuss",
            "email": "dima92konovalenko@gmail.com",
            "homepage": "https://github.com/plutuss"
        }
    ],
    "support": {
        "issues": "https://github.com/plutuss/geo-laravel/issues",
        "source": "https://github.com/plutuss/geo-laravel"
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\GeoNames\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plutuss\\GeoNames\\Providers\\GeoNamesServiceProvider"
            ]
        }
    }
}
